{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "play",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "hoopire.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "BasketballRoom"
      },
      {
        "name": "VISITOR_COUNTER",
        "class_name": "VisitorCounter"
      }
    ]
  },
  "exports": {
    "BasketballRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "VisitorCounter": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
