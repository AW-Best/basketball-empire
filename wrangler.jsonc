{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "basketball-empire",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "BasketballRoom"
      }
    ]
  },
  "exports": {
    "BasketballRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
